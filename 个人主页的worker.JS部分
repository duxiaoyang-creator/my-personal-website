          // 初始化粒子背景
          if (typeof particlesJS !== 'undefined') {
            particlesJS('particles-js', {
              particles: {
                number: { value: 80, density: { enable: true, value_area: 800 } },
                color: { value: "#3b82f6" },
                shape: { type: "circle" },
                opacity: { value: 0.3, random: true },
                size: { value: 3, random: true },
                line_linked: {
                  enable: true,
                  distance: 150,
                  color: "#3b82f6",
                  opacity: 0.2,
                  width: 1
                },
                move: {
                  enable: true,
                  speed: 2,
                  direction: "none",
                  random: false,
                  straight: false,
                  out_mode: "out",
                  bounce: false
                }
              },
              interactivity: {
                detect_on: "canvas",
                events: {
                  onhover: { enable: true, mode: "repulse" },
                  onclick: { enable: true, mode: "push" }
                }
              },
              retina_detect: true
            });
          }
        }, 500);
      }, 1000);
      
      // 打字机效果
      const texts = [
        "探索工业自动化与Web技术的无限可能...",
        "用代码构建智能制造的解决方案...",
        "在工业4.0时代创造真正的价值..."
      ];
      let textIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      const typingElement = document.getElementById('typingText');
      
      function typeWriter() {
        const currentText = texts[textIndex];
        
        if (isDeleting) {
          // 删除字符
          typingElement.textContent = currentText.substring(0, charIndex - 1);
          charIndex--;
        } else {
          // 输入字符
          typingElement.textContent = currentText.substring(0, charIndex + 1);
          charIndex++;
        }
        
        if (!isDeleting && charIndex === currentText.length) {
          // 完成输入，等待后开始删除
          isDeleting = true;
          setTimeout(typeWriter, 2000);
        } else if (isDeleting && charIndex === 0) {
          // 完成删除，切换到下一段文本
          isDeleting = false;
          textIndex = (textIndex + 1) % texts.length;
          setTimeout(typeWriter, 500);
        } else {
          // 继续输入或删除
          const speed = isDeleting ? 50 : 100;
          setTimeout(typeWriter, speed);
        }
      }
      
      // 延迟开始打字效果
      setTimeout(typeWriter, 1500);
      
      // 移动端菜单切换
      const mobileMenuBtn = document.getElementById('mobileMenuBtn');
      const navMenu = document.getElementById('navMenu');
      
      mobileMenuBtn.addEventListener('click', () => {
        navMenu.classList.toggle('active');
        const icon = mobileMenuBtn.querySelector('i');
        if (navMenu.classList.contains('active')) {
          icon.setAttribute('data-lucide', 'x');
        } else {
          icon.setAttribute('data-lucide', 'menu');
        }
        lucide.createIcons();
      });
      
      // 导航链接点击时关闭移动端菜单
      document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
          navMenu.classList.remove('active');
          const icon = mobileMenuBtn.querySelector('i');
          icon.setAttribute('data-lucide', 'menu');
          lucide.createIcons();
        });
      });
      
      // 滚动动画
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('fade-in');
            
            // 如果是技能进度条，则动画显示进度
            if (entry.target.querySelector('.skill-progress-bar')) {
              const progressBars = entry.target.querySelectorAll('.skill-progress-bar');
              progressBars.forEach(bar => {
                const width = bar.getAttribute('data-width') + '%';
                setTimeout(() => {
                  bar.style.width = width;
                }, 300);
              });
            }
          }
        });
      }, observerOptions);
      
      // 观察所有卡片
      document.querySelectorAll('.card').forEach(card => {
        observer.observe(card);
      });
      
      // 平滑滚动
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          e.preventDefault();
          const targetId = this.getAttribute('href');
          if (targetId === '#') return;
          
          const targetElement = document.querySelector(targetId);
          if (targetElement) {
            window.scrollTo({
              top: targetElement.offsetTop - 80,
              behavior: 'smooth'
            });
          }
        });
      });
      
      // 头像加载失败处理
      const avatarImg = document.querySelector('.avatar img');
      if (avatarImg) {
        avatarImg.addEventListener('error', function() {
          this.style.display = 'none';
          const avatarDiv = document.querySelector('.avatar');
          const fallbackText = document.createElement('div');
          fallbackText.textContent = '杜';
          fallbackText.style.position = 'absolute';
          fallbackText.style.top = '50%';
          fallbackText.style.left = '50%';
          fallbackText.style.transform = 'translate(-50%, -50%)';
          fallbackText.style.color = 'white';
          fallbackText.style.fontSize = '3rem';
          fallbackText.style.fontWeight = 'bold';
          avatarDiv.appendChild(fallbackText);
        });
      }
      
      // 控制台欢迎信息
      console.log('%c⚙️ 欢迎来到杜晓阳的个人主页！', 'color: #3b82f6; font-size: 20px; font-weight: bold;');
      console.log('%c🔧 自动化专业开发者 | 工业控制系统与Web技术融合', 'color: #94a3b8; font-size: 14px;');
      console.log('%c📧 联系我: dxyduxiaoyang@outlook.com', 'color: #94a3b8; font-size: 14px;');
      console.log('%c🌐 GitHub: https://github.com/duxiaoyang-creator', 'color: #94a3b8; font-size: 14px;');
      
      // 页面性能监控
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
          console.log('页面从缓存加载');
        }
      });
    });
    
    // 主题切换功能
    function initThemeSwitcher() {
      const themeSwitch = document.getElementById('themeSwitch');
      const themeIcon = document.getElementById('themeIcon');
      
      if (!themeSwitch || !themeIcon) {
        console.error('主题切换元素未找到');
        return;
      }
      
      // 检查本地存储的主题偏好
      const savedTheme = localStorage.getItem('theme');
      
      if (savedTheme === 'light') {
        document.body.classList.add('light-mode');
        themeIcon.setAttribute('data-lucide', 'moon');
        themeSwitch.title = '切换到深色模式';
      } else {
        document.body.classList.remove('light-mode');
        themeIcon.setAttribute('data-lucide', 'sun');
        themeSwitch.title = '切换到浅色模式';
      }
      
      // 重新渲染图标
      lucide.createIcons();
      
      // 主题切换事件
      themeSwitch.addEventListener('click', () => {
        const isLightMode = document.body.classList.contains('light-mode');
        
        if (isLightMode) {
          // 切换到深色模式
          document.body.classList.remove('light-mode');
          localStorage.setItem('theme', 'dark');
          themeIcon.setAttribute('data-lucide', 'sun');
          themeSwitch.title = '切换到浅色模式';
        } else {
          // 切换到浅色模式
          document.body.classList.add('light-mode');
          localStorage.setItem('theme', 'light');
          themeIcon.setAttribute('data-lucide', 'moon');
          themeSwitch.title = '切换到深色模式';
        }
        
        // 重新渲染图标
        lucide.createIcons();
        
        // 添加切换动画效果
