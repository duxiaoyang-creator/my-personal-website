/* 基础样式重置 */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    background-color: #000;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
}

/* 背景效果 */
.bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('images/background.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -2;
    filter: brightness(0.7);
}

.bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.7) 100%);
    z-index: -1;
}

/* 主容器 */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    position: relative;
    z-index: 1;
}

/* 导航栏 */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.logo {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 1px;
}

.logo span {
    font-weight: 300;
    opacity: 0.8;
}

.nav-right {
    display: flex;
    gap: 15px;
    align-items: center;
}

.nav-btn {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    font-size: 16px;
}

.nav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
}

.download-btn {
    background: linear-gradient(135deg, #ff4757, #ff3838);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 25px;
    cursor: pointer;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.download-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 56, 56, 0.3);
}

/* 设备预览选择器 */
.device-preview {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
}

.device-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.device-btn.active {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
}

.device-btn:hover:not(.active) {
    background: rgba(255, 255, 255, 0.15);
}

/* 个人介绍卡片 */
.intro-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 40px;
    margin-bottom: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.intro-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.intro-header h1 {
    font-size: 36px;
    font-weight: 300;
    letter-spacing: 2px;
}

.intro-year {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
}

.intro-year .year {
    font-size: 24px;
    font-weight: 700;
    color: #00cec9;
}

.intro-year .percentage {
    font-size: 14px;
    background: rgba(0, 206, 201, 0.2);
    padding: 2px 8px;
    border-radius: 10px;
    color: #00cec9;
}

.intro-content {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
}

.intro-avatar {
    position: relative;
}

#avatar-img {
    width: 100%;
    border-radius: 15px;
    aspect-ratio: 3/4;
    object-fit: cover;
    filter: grayscale(20%);
}

.avatar-frame {
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    z-index: -1;
}

.intro-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.intro-lead {
    font-size: 18px;
    line-height: 1.8;
}

.highlight {
    color: #00cec9;
    font-weight: 500;
}

.intro-stats {
    display: flex;
    gap: 30px;
    margin-top: 10px;
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-number {
    font-size: 32px;
    font-weight: 700;
    color: #00cec9;
}

.stat-label {
    font-size: 14px;
    opacity: 0.7;
    margin-top: 5px;
}

.intro-actions {
    display: flex;
    gap: 15px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.action-btn {
    padding: 12px 24px;
    border-radius: 25px;
    border: none;
    cursor: pointer;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    text-decoration: none;
    font-size: 14px;
}

.action-btn.primary {
    background: #00cec9;
    color: white;
}

.action-btn.secondary {
    background: transparent;
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.action-btn.social {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    width: 45px;
    height: 45px;
    justify-content: center;
}

.action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.action-btn.primary:hover {
    background: #00b5b2;
}

/* 内容网格布局 */
.content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
}

.content-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 30px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.content-card h2 {
    margin-bottom: 20px;
    font-size: 24px;
    color: #00cec9;
    display: flex;
    align-items: center;
    gap: 10px;
}

/* 项目列表 */
.project-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.project-item {
    background: rgba(255, 255, 255, 0.05);
    padding: 20px;
    border-radius: 10px;
    transition: all 0.3s ease;
}

.project-item:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-5px);
}

.project-item h3 {
    margin-bottom: 10px;
    color: white;
}

.project-item p {
    opacity: 0.8;
    font-size: 14px;
    line-height: 1.6;
}

.project-tags {
    display: flex;
    gap: 8px;
    margin-top: 15px;
    flex-wrap: wrap;
}

.tag {
    background: rgba(0, 206, 201, 0.2);
    color: #00cec9;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 12px;
}

/* 技能条 */
.skills-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.skill-item {
    display: grid;
    grid-template-columns: 100px 1fr 50px;
    align-items: center;
    gap: 15px;
}

.skill-name {
    font-weight: 500;
}

.skill-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
}

.skill-level {
    height: 100%;
    background: linear-gradient(90deg, #00cec9, #00b5b2);
    border-radius: 4px;
    transition: width 1.5s ease;
}

.skill-percent {
    text-align: right;
    font-weight: 500;
    color: #00cec9;
}

/* 页脚 */
.footer {
    text-align: center;
    padding: 30px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 14px;
    opacity: 0.7;
}

.footer a {
    color: #00cec9;
    text-decoration: none;
}

.footer a:hover {
    text-decoration: underline;
}

.footer-info {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 10px;
    flex-wrap: wrap;
}

.footer-info span {
    display: flex;
    align-items: center;
    gap: 5px;
}

/* 响应式设计 */
@media (max-width: 768px) {
    .intro-content {
        grid-template-columns: 1fr;
    }
    
    .intro-avatar {
        max-width: 300px;
        margin: 0 auto;
    }
    
    .content-grid {
        grid-template-columns: 1fr;
    }
    
    .skill-item {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
        gap: 5px;
    }
    
    .skill-percent {
        text-align: left;
    }
    
    .intro-stats {
        justify-content: center;
    }
    
    .footer-info {
        flex-direction: column;
        gap: 10px;
    }
    
    .navbar {
        flex-direction: column;
        gap: 20px;
        text-align: center;
    }
    
    .device-preview {
        flex-wrap: wrap;
    }
}

/* 动画效果 */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.intro-card, .content-card {
    animation: fadeIn 0.8s ease-out;
}